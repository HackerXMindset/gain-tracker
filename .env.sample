API_ID=123456
API_HASH=your_api_hash_here
MGMT_BOT_TOKEN=your_management_bot_token
ADMIN_TELEGRAM_IDS=123456789,987654321
SUPABASE_POOLER_URL=postgres://user:password@host:5432/gain_alert_db
DB_POOL_MIN=2
DB_POOL_MAX=10
TIMEZONE=UTC
SESSIONS_DIR=gain_alert_sessions
DEX_TIMEOUT=10
DEX_MAX_RETRIES=3
JUP_API_KEY=your_jupiter_api_key
# Optional: multiple keys (comma-separated) for fallback/rotation.
JUP_API_KEYS=key1,key2,key3
SOLANA_PATTERN=\\b[1-9A-HJ-NP-Za-km-z]{32,44}\\b
BNB_PATTERN=0x[a-fA-F0-9]{40}\\b
LOG_LEVEL=INFO
SNAPSHOT_TOLERANCE_MINUTES=10
SNAPSHOT_LATE_GRACE_MINUTES=20

# AutoTrader
ENABLE_AUTOTRADER=false
AUTOTRADER_FRESHNESS_SECS=15
AUTOTRADER_MAX_RETRIES=10
AUTOTRADER_DEFAULT_COIN_CAP=100
